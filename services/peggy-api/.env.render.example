# Peggy API on Render — copy to Render Dashboard → Environment (mark secrets as Secret).
# For your private filled copy: cp .env.render.example .env.render.local (gitignored).
#
# Render: Root Directory services/peggy-api | Runtime Docker | Health Check /health
# After deploy: Vercel NEXT_PUBLIC_API_URL=https://YOUR-SERVICE.onrender.com
# Docs: docs/ENV.md, docs/SCALE.md

# --- Supabase Postgres + Auth ---
# DATABASE_URL: Supabase → Settings → Database → Connection string → URI → Transaction pooler (port 6543)
# Use postgres.lmaugorqwhdnotpcqnnf user + your database password (NOT anon key)
DATABASE_URL=postgresql://postgres.lmaugorqwhdnotpcqnnf:[YOUR-DB-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://lmaugorqwhdnotpcqnnf.supabase.co
# JWT Secret: Supabase → Settings → API → JWT Secret (NOT anon/publishable key)
SUPABASE_JWT_SECRET=
AUTH_REQUIRED=true

# --- Qdrant Cloud (one URL only — no commas) ---
QDRANT_URL=https://YOUR-CLUSTER-ID.eu-west-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=

# --- LLM: Groq free tier (console.groq.com → API Keys) — Ollama does not run on Render ---
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- PubMed ---
NCBI_EMAIL=your@email.com
NCBI_API_KEY=

# --- CORS: one origin per entry, comma-separated, NO spaces after commas ---
CORS_ORIGINS=https://peggy-ra.vercel.app,http://localhost:3000

# --- Embeddings ---
# Render Hobby (512MB): MUST use hash — sentence-transformers OOMs on deploy.
EMBEDDING_BACKEND=hash
# EMBEDDING_MODEL only used when EMBEDDING_BACKEND=sentence-transformers or auto (local)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Free-tier quotas (see docs/RESTRICTIONS.md) ---
MAX_PAPERS_PER_USER=200
MAX_WORKSPACES_PER_USER=10
MAX_PMIDS_PER_INGEST=10
MAX_UPLOAD_BYTES=5242880
MAX_TEXT_QUERY_LEN=4000
MAX_AGENT_STEPS=5
RATE_LIMIT_CHAT_PER_HOUR=30
RATE_LIMIT_AGENT_PER_HOUR=15
RATE_LIMIT_INGEST_PER_HOUR=20
RATE_LIMIT_DISCOVER_PER_HOUR=20
RATE_LIMIT_WORKFLOW_PER_HOUR=15

# Optional: Upstash Redis for cross-instance rate limits
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Do NOT set on Render: SQLITE_DB, OLLAMA_URL
