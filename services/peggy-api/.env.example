# Peggy API — copy to .env (gitignored). See docs/LOCAL.md

# --- Solo local stack (recommended) ---
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
NCBI_EMAIL=your@email.com
QDRANT_URL=http://localhost:6333
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SQLITE_DB=./data/peggy.db
AUTH_REQUIRED=false
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Optional: Supabase + Postgres (when NEXT_PUBLIC_SOLO_LOCAL=false) ---
# DATABASE_URL=postgresql://postgres.lmaugorqwhdnotpcqnnf:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# SUPABASE_URL=https://lmaugorqwhdnotpcqnnf.supabase.co
# SUPABASE_JWT_SECRET=
# AUTH_REQUIRED=true

# --- Cloud Qdrant (not needed for solo local) ---
# QDRANT_URL=https://YOUR-CLUSTER.eu-west-1-0.aws.cloud.qdrant.io
# QDRANT_API_KEY=

# --- Render production: cp .env.render.example → .env.render.local ---

EMBEDDING_BACKEND=auto
NCBI_API_KEY=

# Optional: Upstash Redis for cross-instance rate limits (Render)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Discovery (PubMed + Europe PMC + OpenAlex)
# MAX_DISCOVER_RESULTS=50
# DISCOVER_FETCH_PER_SOURCE=75
# OPENALEX_ENABLED=true

# Structured extraction (Phase 2B)
# EXTRACTION_BATCH_SIZE=2
# MAX_EXTRACTION_TEXT_LEN=12000
# EXTRACTION_MODULES=core,outcomes

# GitHub OAuth (optional repo link + doc sync)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/auth/github/callback
# GITHUB_OAUTH_REDIRECT_WEB=http://localhost:3000/dashboard
