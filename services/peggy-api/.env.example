# Peggy API — copy to .env (gitignored). See docs/ENV.md

# --- Local LLM (default) ---
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
NCBI_EMAIL=your@email.com

# --- Vectors: local Qdrant OR Qdrant Cloud (use ONE URL only — no commas) ---
QDRANT_URL=http://localhost:6333
# QDRANT_URL=https://YOUR-CLUSTER.eu-west-1-0.aws.cloud.qdrant.io
# QDRANT_API_KEY=          # Required when using Qdrant Cloud HTTPS URL

# --- Catalog: SQLite when DATABASE_URL unset; Postgres when set ---
SQLITE_DB=./data/peggy.db

# --- Supabase (optional locally; required for Render + auth) ---
# DATABASE_URL: Dashboard → Settings → Database → URI → Transaction pooler :6543
# DATABASE_URL=postgresql://postgres.lmaugorqwhdnotpcqnnf:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# SUPABASE_URL=https://lmaugorqwhdnotpcqnnf.supabase.co
# SUPABASE_JWT_SECRET=     # Settings → API → JWT Secret (NOT anon key)
# AUTH_REQUIRED=true

# --- Render production template: cp .env.render.example → .env.render.local ---
# Paste .env.render.local values into Render Dashboard → Environment

EMBEDDING_BACKEND=auto
NCBI_API_KEY=
CORS_ORIGINS=http://localhost:3000

# Optional: Upstash Redis for cross-instance rate limits (Render)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
